# Copiez ce fichier en ".env.local" pour tester sur votre PC,
# et mettez les mêmes valeurs dans Vercel > Settings > Environment Variables.

# --- WhatsApp (Meta > votre app > WhatsApp > Configuration de l'API) ---
WHATSAPP_TOKEN=collez_le_jeton_ici
WHATSAPP_PHONE_NUMBER_ID=collez_l_identifiant_du_numero_ici
# Un mot de passe que VOUS inventez (le même dans Meta et ici)
WHATSAPP_VERIFY_TOKEN=fikra-boutique-2026
# Optionnel mais conseillé : Meta > Paramètres de l'app > Général > Clé secrète
WHATSAPP_APP_SECRET=

# --- Boutique ---
SHOP_NAME=Boutique Al-Amal
# Jour 3 uniquement : mettez "perroquet". À partir du jour 4 : supprimez cette ligne.
BOT_MODE=

# --- Supabase (jours 6-7) : Project Settings > API ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
